{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "malikz-tool-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "malikz-tool", "database_id": "REPLACE_WITH_CLOUDFLARE_D1_ID", "migrations_dir": "migrations" }
  ],
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "AUTH_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  "vars": {
    "ADMIN_EMAIL": "REPLACE_WITH_OWNER_EMAIL",
    "ALLOWED_ORIGINS": "https://malikz-tool.vercel.app"
  }
}
