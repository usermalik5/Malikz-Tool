{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), usb=(self)"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/auth/status",
      "destination": "/api/[...path]?path=auth/status"
    },
    {
      "source": "/api/auth/bootstrap",
      "destination": "/api/[...path]?path=auth/bootstrap"
    },
    {
      "source": "/api/auth/login",
      "destination": "/api/[...path]?path=auth/login"
    },
    {
      "source": "/api/auth/logout",
      "destination": "/api/[...path]?path=auth/logout"
    },
    {
      "source": "/api/session",
      "destination": "/api/[...path]?path=session"
    },
    {
      "source": "/api/records",
      "destination": "/api/[...path]?path=records"
    },
    {
      "source": "/api/admin/features",
      "destination": "/api/[...path]?path=admin/features"
    }
  ]
}
